        {
          "id": "40061542-8a4c-49a0-afeb-eae1a9de47fb",
          "name": "New Relic Get Applications Instances",
          "request": {
            "name": "New Relic Get Applications Instances",
            "description": {
              "content": "<p>This API endpoint returns a <a href=\"https://docs.newrelic.com/docs/apis/rest-api-v2/requirements/pagination-api-output\" target=\"_blank\">\npaginated</a> list of instances associated with the given application. The time range for summary data is the last 3-4 minutes.</p>\n\n<p>Application instances can be filtered by hostname, or the list of application instance IDs.</p>\n\n<p>See our documentation for a discussion and examples of\nusing <a href=\"https://docs.newrelic.com/docs/apis/rest-api-v2/application-examples-v2/list-application-specific-server-host-instance-ids\" target=\"_blank\"> filters </a>\nand <a href=\"https://docs.newrelic.com/docs/apis/rest-api-v2/application-examples-v2/summary-data-examples-v2\" target=\"_blank\">summary data output</a>.</p>\n\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "applications",
                ":application_id",
                "instances.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "filter[hostname]",
                  "value": "<string>",
                  "description": "Filter by server hostname"
                },
                {
                  "disabled": false,
                  "key": "filter[ids]",
                  "value": "<string>,<string>",
                  "description": "Filter by application instance ids"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Pagination index"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "application_id",
                  "description": "(Required) Application ID"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
