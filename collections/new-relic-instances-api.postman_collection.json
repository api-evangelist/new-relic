        {
          "id": "78aa91dd-c834-40b9-acfd-2688fc980f4b",
          "name": "New Relic Get Applications Instances Instance Metrics Data",
          "request": {
            "name": "New Relic Get Applications Instances Instance Metrics Data",
            "description": {
              "content": "<p>This API endpoint returns a list of values for each of the requested metrics. The list of available metrics\ncan be returned using the Metric Name API endpoint.</p>\n\n<p>Metric data can be filtered by a number of parameters, including multiple names and values, and by time range.\nMetric names and values will be matched intelligently in the background.</p>\n\n<p>You can also retrieve a summarized data point across the entire time range selected by using the summarize\nparameter.</p>\n\n<p>See our documentation for a discussion on <a href=\"https://docs.newrelic.com/docs/apis/rest-api-v2/requirements/pagination-api-output\" target=\"_blank\">\noutput pagination</a>, <a href=\"https://docs.newrelic.com/docs/apis/rest-api-v2/requirements/extracting-metric-data\" target=\"_blank\"> time range</a>\nrelated considerations, and for examples of <a href=\"https://docs.newrelic.com/docs/apis/rest-api-v2/requirements/new-relic-rest-api-v2-getting-started#examples\" target=\"_blank\">requesting and using metric values</a>.</p>\n\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "applications",
                ":application_id",
                "instances",
                ":instance_id",
                "metrics",
                "data.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "names",
                  "value": "<string>,<string>",
                  "description": "(Required) Retrieve specific metrics by name"
                },
                {
                  "disabled": false,
                  "key": "values",
                  "value": "<string>,<string>",
                  "description": "Retrieve specific metric values"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "Retrieve metrics after this time"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<dateTime>",
                  "description": "Retrieve metrics before this time"
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<integer>",
                  "description": "Period of timeslices in seconds"
                },
                {
                  "disabled": false,
                  "key": "summarize",
                  "value": "<boolean>",
                  "description": "Summarize the data"
                },
                {
                  "disabled": false,
                  "key": "raw",
                  "value": "<boolean>",
                  "description": "Return unformatted raw values"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "application_id",
                  "description": "(Required) Application ID"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "instance_id",
                  "description": "(Required) Application Instance ID"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
