          "id": "60a5bb83-449c-4ca8-af37-aa74c0ed4505",
          "name": "New Relic Send Log Data",
          "request": {
            "name": "New Relic Send Log Data",
            "description": {
              "content": "Sends one or more log records to the New Relic Log API. Accepts a JSON array of log data objects, each containing a logs array and optional common attributes. Payloads must be gzip-compressed. A single request may not exceed 1 MB compressed or 10,000 log entries.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "log",
                "v1"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Compression encoding. Gzip is required.",
                "key": "Content-Encoding",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"logs\": [\n      {\n        \"timestamp\": \"<integer>\",\n        \"message\": \"<string>\",\n        \"level\": \"<string>\",\n        \"logtype\": \"<string>\",\n        \"attributes\": {\n          \"key_0\": \"<string>\",\n          \"key_1\": \"<string>\"\n        }\n      },\n      {\n        \"timestamp\": \"<integer>\",\n        \"message\": \"<string>\",\n        \"level\": \"<string>\",\n        \"logtype\": \"<string>\",\n        \"attributes\": {\n          \"key_0\": \"<string>\"\n        },\n        \"key_0\": {},\n        \"key_1\": {}\n      }\n    ],\n    \"common\": {\n      \"timestamp\": \"<integer>\",\n      \"attributes\": {\n        \"key_0\": \"<string>\"\n      }\n    }\n  },\n  {\n    \"logs\": [\n      {\n        \"timestamp\": \"<integer>\",\n        \"message\": \"<string>\",\n        \"level\": \"<string>\",\n        \"logtype\": \"<string>\",\n        \"attributes\": {\n          \"key_0\": \"<string>\"\n        }\n      },\n      {\n        \"timestamp\": \"<integer>\",\n        \"message\": \"<string>\",\n        \"level\": \"<string>\",\n        \"logtype\": \"<string>\",\n        \"attributes\": {\n          \"key_0\": \"<string>\"\n        },\n        \"key_0\": {}\n      }\n    ],\n    \"common\": {\n      \"timestamp\": \"<integer>\",\n      \"attributes\": {\n        \"key_0\": \"<string>\",\n        \"key_1\": \"<string>\"\n      }\n    }\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "ded60660-969e-42cc-8812-8c91684e7eb8",
              "name": "Accepted. Log data was received and queued for processing.",
