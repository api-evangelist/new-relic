      "item": [
        {
          "id": "1abfefed-6ec2-4a23-b45d-9adf1e09968f",
          "name": "New Relic Get Key Transactions",
          "request": {
            "name": "New Relic Get Key Transactions",
            "description": {
              "content": "<p>This API endpoint returns a <a href=\"https://docs.newrelic.com/docs/apis/rest-api-v2/requirements/pagination-api-output\" target=\"_blank\">paginated</a>\nlist of the key transactions associated with your New Relic account.  The time range for summary data is the last 10 minutes.</p>\n\n<p>Key transactions can be filtered by their name or list of IDs.</p>\n\n<p>See our documentation for a discussion of\n<a href=\"https://docs.newrelic.com/docs/apis/rest-api-v2/application-examples-v2/summary-data-examples-v2\" target=\"_blank\">summary data output</a>.</p>\n\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "key_transactions.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "filter[name]",
                  "value": "<string>",
                  "description": "Filter by name"
                },
                {
                  "disabled": false,
                  "key": "filter[ids]",
                  "value": "<string>,<string>",
                  "description": "Filter by policy IDs"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Pagination index"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "14aac8e9-9d29-4cbf-8cfc-044ee22214f4",
              "name": "No response was specified",
              "originalRequest": {
                "url": {
                  "path": [
                    "key_transactions.json"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "filter[name]",
                      "value": "example_string"
                    },
                    {
                      "key": "filter[ids]",
                      "value": "500123"
                    },
                    {
                      "key": "page",
                      "value": "100"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "Api-Key",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "disabled": false,
                  "description": "Links to related resources, in the format defined by [RFC 5988](https://tools.ietf.org/html/rfc5988#section-5). This will include a link with relation type `next` to the next page and `last` to the last page, unless this page is itself the last page.\n",
                  "key": "link",
                  "value": "string,string"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"key_transaction\": {\n    \"application_summary\": {},\n    \"end_user_summary\": {},\n    \"health_status\": {},\n    \"id\": {},\n    \"last_reported_at\": {},\n    \"links\": {},\n    \"name\": {},\n    \"reporting\": {},\n    \"transaction_name\": {}\n  }\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
