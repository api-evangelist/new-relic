{
  "opencollection": "1.0.0",
  "info": {
    "name": "New Relic Event Alerts Data API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Api-Key",
      "value": "{{Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Data",
        "type": "folder"
